<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 开机自动启动 Web 服务（服务内置每日定时拉取）。使用方法见 README「让它一直在后台运行」 -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ibkr-dashboard.server</string>
  <key>WorkingDirectory</key>
  <string>/path/to/ibkr-dashboard</string>
  <key>ProgramArguments</key>
  <array>
    <string>/path/to/ibkr-dashboard/.venv/bin/python</string>
    <string>-m</string>
    <string>app.server</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/path/to/ibkr-dashboard/data/server.log</string>
  <key>StandardErrorPath</key>
  <string>/path/to/ibkr-dashboard/data/server.log</string>
</dict>
</plist>
