# ===== 必填 =====
# Flex Web Service 的 Token（Performance & Reports → Flex Queries → Flex Web Service Configuration）
IBKR_FLEX_TOKEN=
# Activity Flex Query 的 Query ID（点 Query 名字左边的 ⓘ 可以看到）。多个用英文逗号分隔
IBKR_FLEX_QUERY_ID=

# ===== 选填 =====
# 页面展示币种（多账户合并时统一换算成此币种）
DISPLAY_CURRENCY=USD
# 账户别名，格式 账户ID:别名，多个用逗号分隔
ACCOUNT_ALIASES=
# 服务运行期间，每天几点自动拉取一次数据（本机时区，HH:MM）。留空则不自动拉取
AUTO_FETCH_TIME=09:10
# 数据库文件位置
DB_PATH=data/ibkr.db
# Web 服务监听地址和端口。只在本机用写 127.0.0.1；想让手机在局域网访问写 0.0.0.0
HOST=127.0.0.1
PORT=8000
